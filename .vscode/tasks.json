{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build with CS50",
            "command": "gcc",
            "args": [
                "-g",
                "${file}",
                "${fileDirname}/cs50.c",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}